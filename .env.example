# Copia este archivo como .env (en la raíz del proyecto) y completa los valores.
# El archivo .env no se sube al repositorio.

# MySQL (docker-compose.yml y backend)
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_PASSWORD=cambia_esto
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=farmauis_user
MYSQL_DATABASE=farmauis

# Sesiones del backend: usa una cadena larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto

# Usuario administrador que crea "npm run crear-admin" (desde backend/).
# Se puede iniciar sesión con ADMIN_USUARIO o con ADMIN_CORREO.
ADMIN_USUARIO=Admin
ADMIN_CORREO=admin@farmauis.local
ADMIN_PASSWORD=cambia_esto
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=FarmaUIS
