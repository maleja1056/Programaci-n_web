# Copia este archivo como .env (en la raíz del proyecto) y completa los valores.
# El archivo .env no se sube al repositorio.

# MySQL de XAMPP (lo usan el backend y "npm run init-db").
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=farmauis
# Usuario de la aplicación: obligatorio por compatibilidad con el equipo del
# profesor. Lo crea "npm run init-db"; no lo cambies.
MYSQL_USER=un_usr
MYSQL_PASSWORD=una_clave
# Cuenta con permisos para crear la base y el usuario. En XAMPP es root sin
# contraseña; si le pusiste una en phpMyAdmin, escríbela aquí.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# Sesiones del backend: usa una cadena larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto

# Usuarios de prueba que crea "npm run init-db" (desde backend/).
# Se puede iniciar sesión con el usuario o con el correo.
ADMIN_USUARIO=Admin
ADMIN_CORREO=admin@farmauis.local
ADMIN_PASSWORD=1234
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=FarmaUIS
CLIENTE_PASSWORD=cliente123
